<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Poppins,sans-serif;
    background:#f8f5f0;
    color:#171717;
}

a{
    text-decoration:none;
    color:inherit;
}

/* HEADER */

header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    z-index:1000;
    background:rgba(255,255,255,.96);
    backdrop-filter:blur(10px);
    border-bottom:1px solid #eee;
    padding:18px 7%;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    font-family:"Playfair Display",serif;
    font-size:30px;
    font-weight:700;
    letter-spacing:2px;
}

.logo span{
    font-weight:400;
}

nav{
    display:flex;
    gap:30px;
}

nav a{
    font-size:14px;
    color:#555;
    transition:.3s;
}

nav a:hover{
    color:#000;
}

.whatsapp{
    background:#171717;
    color:white;
    padding:12px 22px;
    font-size:13px;
}

/* HERO */

.hero{
    min-height:100vh;
    padding:150px 8% 80px;
    display:flex;
    align-items:center;

    background:
    linear-gradient(90deg,
    rgba(0,0,0,.78),
    rgba(0,0,0,.20)),
    url("https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=1800&q=85");

    background-size:cover;
    background-position:center;
}

.hero-content{
    max-width:700px;
    color:white;
}

.label{
    letter-spacing:5px;
    font-size:12px;
    margin-bottom:20px;
}

.hero h1{
    font-family:"Playfair Display",serif;
    font-size:clamp(55px,8vw,100px);
    line-height:1;
    margin-bottom:25px;
}

.hero h1 span{
    font-style:italic;
    font-weight:400;
}

.hero p{
    font-size:17px;
    line-height:1.8;
    max-width:550px;
    margin-bottom:35px;
}

.buttons{
    display:flex;
    gap:15px;
}

.btn{
    display:inline-block;
    background:white;
    color:#111;
    padding:15px 28px;
    font-size:13px;
    transition:.3s;
}

.btn:hover{
    background:#ddd;
}

.btn-dark{
    background:#171717;
    color:white;
}

.btn-dark:hover{
    background:#333;
}

/* INTRO */

.intro{
    text-align:center;
    max-width:800px;
    margin:auto;
    padding:110px 25px;
}

.intro small{
    letter-spacing:5px;
}

.intro h2{
    font-family:"Playfair Display",serif;
    font-size:50px;
    margin:15px 0 20px;
}

.intro p{
    color:#666;
    line-height:1.9;
}

/* COLLECTION */

.collection{
    padding:90px 7%;
}

.heading{
    display:flex;
    justify-content:space-between;
    align-items:end;
    margin-bottom:45px;
}

.heading small{
    letter-spacing:4px;
}

.heading h2{
    font-family:"Playfair Display",serif;
    font-size:52px;
}

.heading a{
    border-bottom:1px solid #222;
    padding-bottom:5px;
}

.products{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:22px;
}

.product{
    background:white;
    overflow:hidden;
    transition:.4s;
}

.product:hover{
    transform:translateY(-8px);
    box-shadow:0 20px 50px rgba(0,0,0,.12);
}

.product-image{
    height:390px;
    background:#ddd;
    overflow:hidden;
}

.product-image img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.5s;
}

.product:hover img{
    transform:scale(1.05);
}

.product-info{
    padding:22px;
}

.code{
    font-size:11px;
    color:#999;
    letter-spacing:2px;
}

.product h3{
    font-family:"Playfair Display",serif;
    font-size:21px;
    margin:8px 0;
}

.price{
    font-weight:600;
    font-size:17px;
    margin-bottom:15px;
}

.order{
    display:block;
    background:#171717;
    color:white;
    text-align:center;
    padding:11px;
    font-size:12px;
}

